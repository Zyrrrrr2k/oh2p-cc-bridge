<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.cc.listen</string>
	<key>ProgramArguments</key>
	<array>
		<string>$HOME/dsh-voice/venv/bin/python</string>
		<string>-u</string>
		<string>$HOME/dsh-voice/cc_listen_push.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/cc-listen.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/cc-listen.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
